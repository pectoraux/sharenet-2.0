  "description": "Bilateral receipt — mutually-signed attestation that a service session occurred. BOTH the gateway AND the peer sign the receipt body (canonical CBOR map with integer keys, prefixed by the SHARENET/CONTRIBUTION/RECEIPT/1 domain tag). A receipt with only one valid signature is a UNILATERAL claim — it creates NO credit (spec/11).",
  "constants": {
    "receiptDomain": "SHARENET/CONTRIBUTION/RECEIPT/1",
    "bodyEncoding": "canonical CBOR (RFC 8949 §4.2.2), integer-keyed map per ADR-0004",
    "signingPayload": "utf8(RECEIPT_DOMAIN) || canonicalEncode(bodyMap)",
    "bodyMapKeys": {
      "1": "receiptId (string)",
      "2": "gatewayNodeId (string)",
      "3": "peerNodeId (string)",
      "4": "destination (string)",
      "5": "bytesSent (int)",
      "6": "bytesReceived (int)",
      "7": "sessionStart (int)",
      "8": "sessionEnd (int)",
      "9": "httpStatus (int)"
    }
  },
