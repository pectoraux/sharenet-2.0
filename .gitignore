# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# --- ShareNet node-link private key material (NEVER commit) ---
# Per ADR-0015-companion corrective + spec/00 §5: secret values must never
# appear in git history. The mini-service keypair files contain Ed25519
# secret keys — they are runtime-generated for local development only.
mini-services/node-link/data/*/
mini-services/node-link/data/*-keypair.json
!mini-services/node-link/data/README.md

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# tool output artifacts (read tool)
/tool-results/
/tool-results
