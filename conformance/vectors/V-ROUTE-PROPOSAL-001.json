{
  "id": "V-ROUTE-PROPOSAL-001",
  "status": "draft",
  "spec": "spec/07-routing.md §5.1 (FROZEN wire object SignedRouteProposal)",
  "adr": "adr/0017-protocol-freeze-reconciliation.md",
  "description": "SignedRouteProposal wire object: { proposal, signature }. The signature is over the canonical CBOR map of the RouteProposal fields (integer keys per ADR-0004), prefixed by the SHARENET/ROUTE/PROPOSAL/1 domain tag. The proposal MUST NOT carry a routeId — the only route identity is the commitment_root derived later. Mutating ANY semantically-significant proposal field invalidates the signature.",
  "constants": {
    "domain": "SHARENET/ROUTE/PROPOSAL/1",
    "bodyEncoding": "canonical CBOR (RFC 8949 §4.2.2), integer-keyed map per ADR-0004",
    "signingPayload": "utf8(domain) || canonicalEncode(proposal_fields)",
    "bodyMapKeys": {
      "1": "hops[].nodeId (array of text)",
      "2": "requirementDigest (text)",
      "3": "expiry (uint)",
      "4": "initiatorNodeId (text)",
      "5": "agreementDigest (text)"
    },
    "signatureAlgorithm": "Ed25519 (RFC 8032), 64-byte signature",
    "signatureSizeBytes": 64
  },
  "referenceNow": 1786876545,
  "sharedKeys": {
    "initiatorPublicKeyHex": "8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
    "initiatorNodeId": "x357ma3xyrp7zbut665hue65qr2r34eltk2vfbd4lvolm74emrqa",
    "note": "Public key only — no secret-key material is committed. The initiator keypair was derived from a fixed 32-byte test seed inside the generator script for byte stability."
  },
  "vectors": [
