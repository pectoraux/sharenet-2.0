        "reporterNodeId": "yv37fyi6lmqqm7gk3skgdeszc2ngdjh2ruenmkfn2dc2kztakhia",
        "subjectNodeId": "achgovcvfe3rhvcjropbolu3b6wih2nso3rkuh5mdxq53bx2yakq",
        "subjectEndpointHint": "10.0.0.42:7788",
        "claimedCapabilities": [
          "MESH_RELAY",
