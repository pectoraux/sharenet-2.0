  "spec": "spec/06-topology.md §3, §4.2, §4.3; ADR-0007",
  "description": "RemoteNodeHint — signed claim that one node makes about another. A hint is NEVER an AuthenticatedNodeRecord; verifying it only confirms the reporter's signature over the claimed body. The hint-to-record promotion path is FORBIDDEN (guarded by PROMOTE_HINT_TO_RECORD_FORBIDDEN).",
  "constants": {
    "hintSignatureDomain": "SHARENET/HINT/1",
    "maxHintHops": 3,
    "maxHintFreshnessSeconds": 3600,
    "nonceLengthBytes": 16
  },
  "referenceNow": 1786876545,
  "sharedKeys": {
    "reporterPublicKeyHex": "4cb5abf6ad79fbf5abbccafcc269d85cd2651ed4b885b5869f241aedf0a5ba29",
    "reporterNodeId": "yv37fyi6lmqqm7gk3skgdeszc2ngdjh2ruenmkfn2dc2kztakhia",
    "subjectNodeId": "achgovcvfe3rhvcjropbolu3b6wih2nso3rkuh5mdxq53bx2yakq",
    "note": "Public key only — no secret key material is committed in this vector. Reporter's keypair was derived from a fixed test seed inside the generator script for byte stability."
  },
  "vectors": [
    {
      "name": "valid-hint",
      "description": "Genuine RemoteNodeHint: reporter signs the canonical hint body, signature verifies under the reporter's public key, hopCount ≤ MAX_HINT_HOPS, timestamp within freshness window.",
