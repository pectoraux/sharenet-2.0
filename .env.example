# ShareNet 2.0 — environment variable placeholders.
#
# Per spec/00 §5: actual secret values MUST NEVER appear in source code,
# README, specification, ADR, fixtures, golden vectors, test snapshots, logs,
# git history, or pull requests. This file contains ONLY placeholders.
#
# Copy to `.env` and replace the placeholder values with real secrets.
# Never commit the real `.env` file.

# --- Database (per spec/00 §6) ---
# Sandbox (SQLite) per ADR-0001:
DATABASE_URL="file:./db/custom.db"
# Production (Neon Postgres) — uncomment when migrating off the sandbox:
# DATABASE_URL="postgres://user:pass@ep-pooled.region.aws.neon.tech/sharenet?sslmode=require"
# DIRECT_DATABASE_URL="postgres://user:pass@ep-direct.region.aws.neon.tech/sharenet?sslmode=require"

# --- Real admin bootstrap (per spec/00 §8) ---
# Provisioned from env secrets, NEVER hard-coded in source. The first login
# with these credentials creates the real admin account (role=ADMIN, isDemo=false).
ADMIN_BOOTSTRAP_USERNAME="admin@your-domain.example"
ADMIN_BOOTSTRAP_PASSWORD="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# --- Demo accounts (per spec/00 §10 + ADR-0009) ---
# Gates the demo quick-login surface. Default: true in dev, false in prod.
# Demo admin is NOT the real admin bootstrap account.
ENABLE_DEMO_LOGIN="1"

# --- Remote repository (per spec/00 §4) ---
# Used only if the implementation pushes milestones to a remote repo.
# GITHUB_TOKEN=""
# GITHUB_OWNER=""
# GITHUB_REPOSITORY=""
