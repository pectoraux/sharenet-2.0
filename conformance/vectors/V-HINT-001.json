        "hopCount": 1,
        "timestamp": 1786876545,
        "nonceHex": "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6",
        "tamperedReporterSignatureHex": "e607d26203b153ebf63e8a4a2326a3e0edb357112f592fc77c1c9a8e83b8ac1fdb768fc030e0e5ccb309ce065f285f5148f699abfcacf53111d7277244289006",
